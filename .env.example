# .env.staging - Staging Environment Variables

# Simulator Configuration
NUM_TRUCKS=10
UPDATE_INTERVAL=2

# Kafka Configuration
KAFKA_BROKER=kafka:9092
KAFKA_PORT=9092
KAFKA_TOPIC=truck-gps-staging

# MinIO Configuration (Can be used as fallback)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=fleet-data-staging
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

STORAGE_BACKEND=minio

LAKE_BUCKET=fleet-data-lake
LAKE_PREFIX=silver/truck_history

# GCS Configuration (Primary storage for staging)
#STORAGE_BACKEND=gcs
GCS_BUCKET=your-gcs-bucket-staging
GCS_KEYFILE=/secrets/gcp-key-staging.json
BIGQUERY_PROJECT=your-gcp-project-staging
BIGQUERY_DATASET=fleet_analytics_staging


# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fleet

SPARK_MASTER=local[2]


## Streamlit App Configuration
## Streamlit App Configuration
APP_TITLE=Fleet Command Center
APP_SUBTITLE=Speed Layer Streaming Command Center
APP_THEME=dark
APP_PAGE_ICON=:truck:
REFRESH_INTERVAL_SECONDS=5
CACHE_TTL_SECONDS=5
MAX_BUFFER_SNAPSHOTS=72
STALE_AFTER_SECONDS=25

CASSANDRA_CONNECT_RETRIES=12
CASSANDRA_CONNECT_DELAY_SECONDS=3

OVERSPEED_KMH=120
CRITICAL_SPEED_KMH=145
LOW_FUEL_PCT=20
CRITICAL_FUEL_PCT=10
HIGH_TEMP_C=100
CRITICAL_TEMP_C=112
SUSPICIOUS_FUEL_DROP_PCT=6
GPS_JUMP_SPEED_KMH=155
NO_MOVEMENT_DISTANCE_KM=0.05

MAP_LATITUDE=33.88
MAP_LONGITUDE=-6.85
MAP_ZOOM=4.8
MAP_PITCH=38

DEFAULT_CHART_HEIGHT=330
EXPLORER_CHART_HEIGHT=360
MAP_HEIGHT=520
LOG_LEVEL=INFO
