# .env.staging - Staging Environment Variables

# Simulator Configuration
NUM_TRUCKS=10
UPDATE_INTERVAL=2

# Kafka Configuration
KAFKA_BROKER=kafka:9092
KAFKA_PORT=9092
KAFKA_TOPIC=truck-gps-staging

# MinIO Configuration (Can be used as fallback)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=fleet-data-staging
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

STORAGE_BACKEND=minio

LAKE_BUCKET=fleet-data-lake
LAKE_PREFIX=silver/truck_history

# GCS Configuration (Primary storage for staging)
#STORAGE_BACKEND=gcs
GCS_BUCKET=your-gcs-bucket-staging
GCS_KEYFILE=/secrets/gcp-key-staging.json
BIGQUERY_PROJECT=your-gcp-project-staging
BIGQUERY_DATASET=fleet_analytics_staging


# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fleet

SPARK_MASTER=local[2]


## Streamlit App Configuration
APP_ENV=development
APP_TITLE=Fleet Command Center
APP_ICON=FC
DEFAULT_THEME=dark
LOG_LEVEL=INFO
APP_CONFIG_FILE=config/app_config.yaml

CASSANDRA_CONNECT_RETRIES=10
CASSANDRA_CONNECT_DELAY_SECONDS=3

REALTIME_CACHE_TTL_SECONDS=15
REALTIME_REFRESH_INTERVAL_SECONDS=10
REALTIME_DEFAULT_LOOKBACK_MINUTES=30
REALTIME_STALE_AFTER_MINUTES=5

BATCH_CACHE_TTL_SECONDS=300
BATCH_DEFAULT_RANGE_DAYS=7
BATCH_MAX_RANGE_DAYS=31
BATCH_LATEST_SEARCH_DAYS=30
