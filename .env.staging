# .env.staging - Staging Environment Variables

# Kafka Configuration
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC=truck-gps-staging

# MinIO Configuration (Can be used as fallback)
MINIO_ROOT_USER=minioadmin_staging
MINIO_ROOT_PASSWORD=minioadmin_staging_secure
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=fleet-data-staging
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000


# Storage Backend
STORAGE_BACKEND=minio

# GCS Configuration (Primary storage for staging)
#STORAGE_BACKEND=gcs
GCS_BUCKET=your-gcs-bucket-staging
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key-staging.json

# Ports
KAFKA_PORT=9092
