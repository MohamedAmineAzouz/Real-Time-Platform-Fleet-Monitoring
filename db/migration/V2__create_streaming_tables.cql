
CREATE TABLE IF NOT EXISTS truck_latest (
    truck_id                int,
    processed_at            timestamp,
    event_time              timestamp,
    latitude                double,
    longitude               double,
    speed                   double,
    fuel_level              double,
    engine_temp             double,
    driver_id               text,
    start_city              text,
    end_city                text,
    odometer_km             double,
    refueling               boolean,
    refuel_city             text,
    anomaly                 text,
    theft                   boolean,
    theft_amount            double,
    alert_type              text,
    is_alert                boolean,
    distance_km             double,
    fuel_used               double,
    fuel_consumption_rate   double,
    high_consumption        boolean,
    fuel_consumed_trip      double,
    fuel_refueled           double,
    in_maintenance          boolean,
    maintenance_type        text,
    maintenance_desc        text,
    PRIMARY KEY (truck_id)
);


CREATE TABLE IF NOT EXISTS truck_history (
    truck_id                int,
    processed_at            timestamp,
    event_time              timestamp,
    latitude                double,
    longitude               double,
    speed                   double,
    fuel_level              double,
    engine_temp             double,
    driver_id               text,
    start_city              text,
    end_city                text,
    odometer_km             double,
    refueling               boolean,
    refuel_city             text,
    anomaly                 text,
    theft                   boolean,
    theft_amount            double,
    alert_type              text,
    is_alert                boolean,
    distance_km             double,
    fuel_used               double,
    fuel_consumption_rate   double,
    high_consumption        boolean,
    fuel_consumed_trip      double,
    fuel_refueled           double,
    in_maintenance          boolean,
    maintenance_type        text,
    maintenance_desc        text,
    PRIMARY KEY (truck_id, processed_at)
) WITH CLUSTERING ORDER BY (processed_at DESC)
  AND default_time_to_live = 86400;


CREATE TABLE IF NOT EXISTS alerts (
    truck_id                int,
    alert_type              text,
    processed_at            timestamp,
    event_time              timestamp,
    latitude                double,
    longitude               double,
    speed                   double,
    fuel_level              double,
    engine_temp             double,
    driver_id               text,
    anomaly                 text,
    theft                   boolean,
    theft_amount            double,
    distance_km             double,
    fuel_consumption_rate   double,
    fuel_consumed_trip      double,
    fuel_refueled           double,
    in_maintenance          boolean,
    maintenance_type        text,
    maintenance_desc        text,
    PRIMARY KEY ((truck_id, alert_type), processed_at)
) WITH CLUSTERING ORDER BY (processed_at DESC)
  AND default_time_to_live = 604800;
